<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Only an id: the secrets themselves live outside the repository, in %APPDATA%\Microsoft\UserSecrets\<id>\secrets.json. -->
    <UserSecretsId>e6e703e4-73b9-49c9-a95a-8a2c1855cc91</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QueuEase.Services\QueuEase.Services.csproj" />
    <ProjectReference Include="..\QueuEase.Data\QueuEase.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed only by the "dotnet ef" tool at design time; PrivateAssets keeps it out of the published app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
